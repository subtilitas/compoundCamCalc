{
  "name": "compound-cam-calc",
  "version": "0.2.0",
  "private": true,
  "description": "Twin-cam compound bow cam calculator: string and cable track design from a target draw force curve, DXF and STEP export",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/coverage-readme.js --check",
    "coverage:update": "vitest run --coverage && node scripts/coverage-readme.js --write",
    "e2e": "playwright test",
    "check:links": "node scripts/check-session-links.js",
    "check": "npm run lint && npm run typecheck && npm run check:links && npm run test:coverage && npm run coverage:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "occt-import-js": "^0.0.23",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
